#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "poclegs"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "poclegs"
{
    over "Physics"
    {
        over "LL_HR" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LL_HAA" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LL_HFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LL_KFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LL_FFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LR_HR" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LR_HAA" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LR_HFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LR_KFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LR_FFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

