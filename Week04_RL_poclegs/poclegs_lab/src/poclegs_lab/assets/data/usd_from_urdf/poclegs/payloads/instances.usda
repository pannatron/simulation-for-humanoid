#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "base_visual" (
        prepend references = @./geometries.usd@</Geometries/base_visual>
    )
    {
        over "base_visual" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/base_visual/VisualMaterials/base_color>
        }

        def Scope "VisualMaterials"
        {
            def Material "base_color" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/base_color>
            )
            {
            }
        }
    }

    def Xform "base_visual_1" (
        prepend references = @./geometries.usd@</Geometries/base_visual>
    )
    {
        over "base_visual" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

