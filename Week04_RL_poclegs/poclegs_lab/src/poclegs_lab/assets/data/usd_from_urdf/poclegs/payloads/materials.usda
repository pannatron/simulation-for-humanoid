#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "base_color"
    {
        color3f inputs:diffuseColor = (0.8069525, 0.41788453, 0.016807394)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
            doc = '''Represents the universal "displacement" output terminal of a 
        material.'''
        )
        prepend token outputs:displacement.connect = </Materials/base_color/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
            doc = '''Represents the universal "surface" output terminal of a
        material.'''
        )
        prepend token outputs:surface.connect = </Materials/base_color/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
            doc = '''Represents the universal "volume" output terminal of a
        material.'''
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/base_color.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/base_color.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/base_color.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/base_color.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "ll_hr_color"
    {
        color3f inputs:diffuseColor = (0.057805583, 0.304987, 0.06480331)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
            doc = '''Represents the universal "displacement" output terminal of a 
        material.'''
        )
        prepend token outputs:displacement.connect = </Materials/ll_hr_color/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
            doc = '''Represents the universal "surface" output terminal of a
        material.'''
        )
        prepend token outputs:surface.connect = </Materials/ll_hr_color/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
            doc = '''Represents the universal "volume" output terminal of a
        material.'''
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/ll_hr_color.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/ll_hr_color.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/ll_hr_color.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/ll_hr_color.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }
}

